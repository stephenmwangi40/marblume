{
  "name": "marblume",
  "version": "1.9.0",
  "private": true,
  "description": "Marblume: Ball Sort Puzzle — 10,000 hard, unique levels.",
  "type": "module",
  "scripts": {
    "levels": "node scripts/prepare-levels.mjs",
    "build:web": "node scripts/prepare-levels.mjs && node scripts/build-i18n.mjs && node scripts/copy-fonts.mjs",
    "sync": "npm run build:web && npx cap sync",
    "build:site": "node scripts/build-site.mjs",
    "deploy:site": "node scripts/build-site.mjs && npx wrangler deploy",
    "levels:verify": "node scripts/verify-levels.mjs --solve"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor/text-zoom": "^8.0.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^24.43.1"
  }
}
