{
  "appId": "com.marblume.ballsort",
  "appName": "Marblume",
  "webDir": "www",
  "backgroundColor": "#16213A",
  "android": {
    "backgroundColor": "#16213A",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#16213A",
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 150,
      "backgroundColor": "#0B1222",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    }
  }
}
