{
  // Marblume website: static files in ./site (built by `npm run build:site`)
  // plus worker/index.js for support conversations (/api/*) and the admin page (/admin).
  "name": "marblume",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/inbox", "/inbox/", "/features", "/profile", "/worlds", "/collect", "/faq", "/get", "/support/contact"]
  },
  "d1_databases": [
    { "binding": "SUPPORT", "database_name": "marblume-support", "database_id": "dae436bc-46f7-4679-a971-e4e8c5c51a5e" }
  ],
  "kv_namespaces": [
    { "binding": "MARBLUME_MESSAGES", "id": "a11cf6d1c0af4f66a8a6487cbe7843aa" }
  ]
}
